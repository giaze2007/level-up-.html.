<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>LEVEL UP — Connect. Play. Grow.</title>
<meta name="description" content="LEVEL UP is a place to connect with your people, play together, and grow your ideas.">
<style>
:root{--bg:#fbf7ff;--panel:#ffffff;--panel2:#f2eaff;--ink:#281b42;--muted:#766887;--purple:#9254f5;--pink:#f36bb7;--lime:#ffd66b;--line:rgba(95,58,145,.14);--shadow:0 18px 50px rgba(100,60,160,.13)}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(ellipse at 88% 0%,#e9dcff 0,transparent 38%),radial-gradient(ellipse at 0% 28%,#fff0b8 0,transparent 34%),radial-gradient(ellipse at 55% 45%,#ffe3df 0,transparent 40%),var(--bg);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
a{color:inherit;text-decoration:none}button,input,textarea{font:inherit}button{cursor:pointer;border:0}
.wrap{width:min(1120px,92%);margin:auto}.topbar{position:sticky;top:0;z-index:20;background:rgba(247,251,255,.86);backdrop-filter:blur(16px);border-bottom:1px solid var(--line)}
.nav{height:76px;display:flex;align-items:center;justify-content:space-between;gap:18px}.brand{display:flex;align-items:center;gap:10px;font-weight:950;letter-spacing:-1.3px;font-size:1.25rem}.logo{width:39px;height:39px;border-radius:13px;display:grid;place-items:center;background:linear-gradient(135deg,#ffd66b,#f36bb7);color:#281b42;font-weight:1000;box-shadow:0 8px 24px #9254f533}.logo span{font-size:1.02rem}.navlinks{display:flex;gap:26px;color:var(--muted);font-size:.92rem}.navlinks a:hover{color:var(--purple)}.navright{display:flex;align-items:center;gap:10px}.btn{display:inline-flex;justify-content:center;align-items:center;gap:8px;padding:12px 17px;border-radius:14px;font-weight:800;transition:transform .18s,filter .18s}.btn:hover{transform:translateY(-2px);filter:brightness(1.08)}.primary{background:linear-gradient(115deg,#ffd66b,#f36bb7);color:#281b42;box-shadow:0 8px 28px #f36bb735}.secondary{border:1px solid var(--line);background:#ffffff;color:var(--ink)}.small{padding:9px 13px;font-size:.88rem}
.hero{padding:76px 0 48px;display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:46px;min-height:560px}.eyebrow{display:inline-flex;align-items:center;gap:8px;border:1px solid #9254f54d;border-radius:999px;padding:8px 12px;color:#7844bd;background:#ffd66b25;font-size:.82rem;font-weight:800}.spark{width:7px;height:7px;background:var(--lime);border-radius:50%;box-shadow:0 0 14px var(--lime)}h1{font-size:clamp(3.25rem,7vw,5.9rem);line-height:.94;letter-spacing:-.075em;margin:23px 0 20px;max-width:650px}h1 em{font-style:normal;background:linear-gradient(100deg,var(--purple),var(--pink));-webkit-background-clip:text;background-clip:text;color:transparent}.hero p{font-size:1.08rem;line-height:1.75;color:var(--muted);max-width:540px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin:27px 0 20px}.micro{font-size:.82rem;color:#9389ad}.visual{position:relative;min-height:420px;display:grid;place-items:center}.orb{position:absolute;width:340px;height:340px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff0b8, #ffb6df 28%,#c8b4ff 56%,#9254f5 76%);filter:drop-shadow(0 0 60px #9254f525);opacity:.95}.orbit{position:absolute;width:410px;height:180px;border:1px solid #d9c8ff45;border-radius:50%;transform:rotate(-28deg)}.orbit.two{transform:rotate(48deg);width:390px;height:220px;border-color:#f36bb745}.float-card{position:absolute;border:1px solid #ffffff22;background:linear-gradient(145deg,#ffffffee,#f2eaffee);box-shadow:var(--shadow);backdrop-filter:blur(12px);border-radius:20px;padding:15px 17px}.float-card strong{display:block;font-size:.95rem}.float-card small{color:var(--muted)}.card-a{top:42px;left:0;transform:rotate(-5deg)}.card-b{right:-2px;top:132px;transform:rotate(4deg)}.card-c{left:28px;bottom:38px;transform:rotate(3deg)}.avatar-row{display:flex;margin-top:10px}.avatar{width:31px;height:31px;margin-right:-7px;border:2px solid #fdf9ff;border-radius:50%;display:grid;place-items:center;font-size:.9rem;background:#f36bb7}.avatar:nth-child(2){background:#79dfd0}.avatar:nth-child(3){background:#ffd66b}.avatar:nth-child(4){background:#9254f5}.level-chip{position:absolute;right:28px;bottom:32px;padding:12px 15px;border-radius:15px;background:var(--lime);color:#281b42;font-weight:950;transform:rotate(-6deg);box-shadow:0 10px 30px #ffd66b33}
.section{padding:60px 0}.section-head{display:flex;align-items:end;justify-content:space-between;gap:22px;margin-bottom:24px}.kicker{color:#d94caa;font-size:.78rem;letter-spacing:.16em;font-weight:900;text-transform:uppercase}.section h2{font-size:clamp(2rem,4vw,3.2rem);letter-spacing:-.06em;margin:9px 0 0}.section-head p{color:var(--muted);max-width:420px;line-height:1.6;margin:0}.pillars{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.pillar{border:1px solid var(--line);border-radius:24px;padding:24px;background:linear-gradient(145deg,#ffffff0b,#ffffff03);min-height:225px;transition:transform .2s,border-color .2s}.pillar:hover{transform:translateY(-5px);border-color:#9254f575}.icon{width:49px;height:49px;display:grid;place-items:center;border-radius:16px;background:#9254f51b;font-size:1.45rem;margin-bottom:22px}.pillar:nth-child(2) .icon{background:#f36bb71b}.pillar:nth-child(3) .icon{background:#ffd66b33}.pillar h3{font-size:1.28rem;margin:0 0 9px}.pillar p{color:var(--muted);line-height:1.65;margin:0;font-size:.94rem}
.preview{display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:stretch}.feature-panel{border-radius:26px;border:1px solid var(--line);background:linear-gradient(140deg,#ffffff,#f2eaff);padding:27px;overflow:hidden;position:relative}.feature-panel h3{font-size:1.7rem;letter-spacing:-.04em;margin:9px 0}.feature-panel p{color:var(--muted);line-height:1.65;max-width:460px}.mini-feed{margin-top:20px;background:#ffffff;border:1px solid var(--line);border-radius:18px;padding:15px}.feed-top{display:flex;align-items:center;gap:10px;font-size:.9rem}.face{width:35px;height:35px;border-radius:12px;display:grid;place-items:center;background:#ffd66b;color:#281b42;font-weight:900}.feed-top small{display:block;color:var(--muted)}.feed-text{color:#413257;line-height:1.55;margin:13px 0}.feed-actions{display:flex;gap:9px;flex-wrap:wrap}.tag{border:1px solid var(--line);border-radius:999px;padding:7px 10px;color:#69577e;font-size:.8rem;background:#ffffff}.game-card{margin-top:20px;display:flex;align-items:center;justify-content:space-between;gap:16px;border-radius:18px;padding:17px;background:linear-gradient(110deg,#e5f7ff,#eee1ff)}.game-card b{display:block}.game-card small{color:#766887}.game-emoji{font-size:2.4rem}
.community-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.community{border:1px solid var(--line);border-radius:19px;padding:18px;background:#ffffff}.community .emoji{font-size:1.55rem}.community h4{margin:12px 0 5px;font-size:1rem}.community p{margin:0 0 14px;color:var(--muted);font-size:.86rem;line-height:1.5}.community button{width:100%}.joined{background:#ffd66b;color:#281b42}
.join{padding:45px 0 75px}.joinbox{border:1px solid #9254f538;background:radial-gradient(ellipse at 90% 0%,#e9dcff,transparent 45%),linear-gradient(120deg,#fff6e6,#f0f6ff);border-radius:30px;padding:clamp(25px,5vw,48px);display:flex;justify-content:space-between;align-items:center;gap:24px}.joinbox h2{font-size:clamp(2rem,4vw,3.1rem);letter-spacing:-.06em;margin:0 0 10px}.joinbox p{color:var(--muted);margin:0;line-height:1.6;max-width:550px}.join-form{display:flex;gap:9px;flex-wrap:wrap;margin-top:20px}.join-form input{min-width:220px;max-width:100%;background:#ffffff;border:1px solid var(--line);border-radius:13px;padding:13px 14px;color:var(--ink);outline:none}.join-form input:focus{border-color:#7844bd}.form-note{font-size:.83rem;color:#7844bd;margin-top:10px;min-height:1.2em}.footer{border-top:1px solid var(--line);padding:24px 0 34px;color:var(--muted);font-size:.85rem}.footer-inner{display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap}.notice{color:#8e7ba8;font-size:.76rem;line-height:1.5;margin-top:14px}
.toast{position:fixed;bottom:22px;left:50%;transform:translate(-50%,20px);opacity:0;pointer-events:none;z-index:50;background:#ffffff;color:#281b42;padding:12px 17px;border-radius:13px;font-weight:800;box-shadow:var(--shadow);transition:.25s}.toast.show{opacity:1;transform:translate(-50%,0)}
@media(max-width:800px){.navlinks{display:none}.hero{grid-template-columns:1fr;padding-top:54px;gap:8px}.visual{min-height:360px}.orb{width:270px;height:270px}.orbit{width:330px}.card-a{left:2%}.card-b{right:0}.pillars,.community-grid{grid-template-columns:1fr}.preview{grid-template-columns:1fr}.section-head{display:block}.section-head p{margin-top:12px}.joinbox{display:block}.joinbox>.btn{margin-top:22px}.hero h1{font-size:clamp(3.3rem,16vw,5.2rem)}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto;transition:none!important}}
</style>
</head>
<body>
<header class="topbar"><div class="wrap nav">
<a class="brand" href="#home" aria-label="LEVEL UP home"><span class="logo"><span>LU</span></span><span>LEVEL UP</span></a>
<nav class="navlinks" aria-label="Main navigation"><a href="#discover">Discover</a><a href="#play">Play</a><a href="#communities">Communities</a><a href="#business">Build</a></nav>
<div class="navright"><a class="btn secondary small" href="#communities">Explore</a><a class="btn primary small" href="#join">Get early access ↗</a></div>
</div></header>
<main id="home">
<section class="wrap hero">
<div><div class="eyebrow"><span class="spark"></span> YOUR NEXT CHAPTER STARTS HERE</div>
<h1>Your people.<br>Your play.<br><em>Your level up.</em></h1>
<p>Meet people who get you, jump into challenges, find your community, and turn big ideas into real opportunities. One place. More possibilities.</p>
<div class="actions"><a class="btn primary" href="#join">Join the early list <span>↗</span></a><a class="btn secondary" href="#discover">See what’s inside ↓</a></div>
<div class="micro">A bright, open social world for connection, play and possibility.</div></div>
<div class="visual" aria-label="Decorative preview of the LEVEL UP community">
<div class="orb"></div><div class="orbit"></div><div class="orbit two"></div>
<div class="float-card card-a"><strong>✨ Your next connection</strong><small>People with your kind of energy</small><div class="avatar-row"><span class="avatar">M</span><span class="avatar">A</span><span class="avatar">Z</span><span class="avatar">+</span></div></div>
<div class="float-card card-b"><strong>🎮 Challenge unlocked</strong><small>Campus creativity · 2.4k playing</small></div>
<div class="float-card card-c"><strong>🚀 Idea → opportunity</strong><small>Make your next move count</small></div>
<div class="level-chip">LEVEL UP! ↑</div>
</div></section>
<section class="section wrap" id="discover"><div class="section-head"><div><div class="kicker">One platform. Three ways to grow.</div><h2>Find your kind of level.</h2></div><p>Whether you want to meet your people, have fun, or take an idea somewhere bigger, start where you are.</p></div>
<div class="pillars">
<article class="pillar"><div class="icon">🫶</div><h3>CONNECT</h3><p>Share moments, join interest-based communities, talk about what matters and find people with common ground.</p></article>
<article class="pillar" id="play"><div class="icon">🎮</div><h3>PLAY</h3><p>Take on mini-games, friendly challenges and creative missions. Collect achievements and celebrate progress.</p></article>
<article class="pillar" id="business"><div class="icon">🚀</div><h3>BUILD</h3><p>Showcase your work, discover small businesses, meet collaborators and explore opportunities to grow.</p></article>
</div></section>
<section class="section wrap"><div class="section-head"><div><div class="kicker">A little preview</div><h2>Made for real life.</h2></div><p>Less endless scrolling. More things to do, people to meet and ideas to move forward.</p></div>
<div class="preview">
<div class="feature-panel"><div class="kicker">THE COMMUNITY FEED</div><h3>Bring your whole self.</h3><p>From campus conversations to creative wins, make space for your interests and your voice.</p>
<div class="mini-feed">
<div class="publish-box" style="margin-bottom:14px;padding-bottom:14px;border-bottom:1px solid var(--line)">
<label for="postText" style="display:block;font-weight:800;margin-bottom:8px">✨ Share something with your people</label>
<textarea id="postText" rows="2" placeholder="What’s on your mind?" style="width:100%;resize:vertical;border:1px solid var(--line);border-radius:13px;padding:12px;background:#fff;color:var(--ink);outline-color:var(--purple)"></textarea>
<div style="display:flex;justify-content:flex-end;margin-top:8px"><button class="btn primary small" id="publishPost" type="button">Publish post ↗</button></div>
<div id="publishNote" class="form-note" aria-live="polite"></div>
</div>
<div id="publishedPosts"></div>
<div class="feed-top"><div class="face">S</div><div><b>Samira's space</b><small>Creative Corner · just now</small></div></div><div class="feed-text">Small progress is still progress ✨ What’s one thing you want to get better at this month?</div><div class="feed-actions"><button class="tag like-btn">♡ Like <span>0</span></button><button class="tag comment-btn">💬 Reply</button><span class="tag">#Growth</span></div></div></div>
<div class="feature-panel"><div class="kicker">THE FUN SIDE</div><h3>Make the group chat jealous.</h3><p>Jump into quick challenges, play with friends and unlock little wins along the way.</p>
<div class="game-card"><div><b>⚡ Quickfire Quiz</b><small>5 questions. One-minute challenge.</small><div style="margin-top:12px"><button class="btn primary small" id="playQuiz">Try a sample round ↗</button></div></div><div class="game-emoji">🧠</div></div>
<div class="game-card"><div><b>🌱 Build Club</b><small>Ideas, feedback and new collaborators.</small></div><div class="game-emoji">💡</div></div></div>
</div></section>
<section class="section wrap" id="communities"><div class="section-head"><div><div class="kicker">Find your people</div><h2>There’s room for your interests.</h2></div><p>Tap a community to try the interaction. This demo saves your choices in this browser only.</p></div>
<div class="community-grid">
<article class="community"><div class="emoji">🎓</div><h4>Campus After Class</h4><p>Student life, study buddies, events and everything beyond lectures.</p><button class="btn secondary small join-btn">Join community</button></article>
<article class="community"><div class="emoji">🎨</div><h4>Creative Corner</h4><p>Share art, designs, content, music and works in progress.</p><button class="btn secondary small join-btn">Join community</button></article>
<article class="community"><div class="emoji">💼</div><h4>Build Club</h4><p>Small business, side projects, feedback and collaboration.</p><button class="btn secondary small join-btn">Join community</button></article>
</div></section>
<section class="join wrap" id="join"><div class="joinbox"><div><div class="kicker">BE PART OF THE FIRST WAVE</div><h2>Ready for your next level?</h2><p>Join the early-interest list for product updates and opportunities to test LEVEL UP as it develops.</p><form class="join-form" id="signup"><input id="email" type="email" placeholder="Your email address" aria-label="Your email address" required><button class="btn primary" type="submit">Count me in ↗</button></form><div class="form-note" id="formNote" aria-live="polite"></div><div class="notice">Prototype note: this form saves the email only in your current browser. It does not send it to a server yet. Do not enter sensitive information.</div></div><a class="btn secondary" href="#home">Back to top ↑</a></div></section>
</main>
<footer class="footer"><div class="wrap footer-inner"><div class="brand"><span class="logo"><span>LU</span></span><span>LEVEL UP</span></div><div>Connect. Play. Grow.</div><div>© <span id="year"></span> LEVEL UP · Prototype concept</div></div></footer>
<div class="toast" id="toast" role="status" aria-live="polite"></div>
<script>
const toast = (msg) => { const el=document.getElementById('toast'); el.textContent=msg; el.classList.add('show'); clearTimeout(window.toastTimer); window.toastTimer=setTimeout(()=>el.classList.remove('show'),2400); };
document.getElementById('year').textContent = new Date().getFullYear();
document.getElementById('publishPost').addEventListener('click',()=>{
 const field=document.getElementById('postText'); const text=field.value.trim();
 if(!text){document.getElementById('publishNote').textContent='Write a little something before publishing.';field.focus();return;}
 const container=document.getElementById('publishedPosts'); const card=document.createElement('div'); card.style.cssText='border:1px solid var(--line);border-radius:14px;padding:12px;margin:10px 0;background:linear-gradient(120deg,#fff,#f8efff)';
 const heading=document.createElement('strong'); heading.textContent='You · just now'; heading.style.display='block';
 const body=document.createElement('p'); body.textContent=text; body.style.cssText='white-space:pre-wrap;line-height:1.5;margin:8px 0 0;color:var(--ink)';
 card.append(heading,body); container.prepend(card); field.value=''; document.getElementById('publishNote').textContent='Published in this demo preview. It is visible only in this browser session.'; toast('Your post is published in the demo!');
});
document.querySelectorAll('.join-btn').forEach(btn=>btn.addEventListener('click',()=>{const joined=btn.classList.toggle('joined');btn.textContent=joined?'✓ Joined':'Join community';toast(joined?'You joined this demo community!':'You left this demo community.');}));
document.querySelectorAll('.like-btn').forEach(btn=>btn.addEventListener('click',()=>{let count=Number(btn.querySelector('span').textContent);count=btn.classList.toggle('liked')?count+1:Math.max(0,count-1);btn.querySelector('span').textContent=count;btn.firstChild.textContent=btn.classList.contains('liked')?'♥ Like ':'♡ Like ';}));
document.querySelectorAll('.comment-btn').forEach(btn=>btn.addEventListener('click',()=>toast('Replies will be available in a connected version.')));
document.getElementById('playQuiz').addEventListener('click',()=>{const questions=[{q:'Which is a good first step for a new business?',a:['Understand your customers','Spend everything on a logo','Wait for perfect timing'],correct:0},{q:'What helps a community feel welcoming?',a:['Respectful conversation','Mocking new members','Sharing private details'],correct:0},{q:'What does steady progress look like?',a:['Small consistent steps','Never making mistakes','Comparing every day'],correct:0}];let score=0;for(const item of questions){const answer=prompt(item.q+'\\n1. '+item.a[0]+'\\n2. '+item.a[1]+'\\n3. '+item.a[2]+'\\n\\nEnter 1, 2 or 3 to answer (Cancel to stop):');if(answer===null)break;if(Number(answer)-1===item.correct)score++;}toast('Sample round complete: '+score+' correct!');});
document.getElementById('signup').addEventListener('submit',e=>{e.preventDefault();const email=document.getElementById('email').value.trim();if(!email)return;try{const list=JSON.parse(localStorage.getItem('levelUpInterestEmails')||'[]');if(!list.includes(email))list.push(email);localStorage.setItem('levelUpInterestEmails',JSON.stringify(list));document.getElementById('formNote').textContent='Saved in this browser. Server signup is not connected yet.';document.getElementById('email').value='';toast('Thanks for your interest!');}catch(err){document.getElementById('formNote').textContent='Browser storage was unavailable. This demo is not connected to a server.';}});
</script>
</body>
</html>
